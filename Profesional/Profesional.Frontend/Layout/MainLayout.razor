@using Profesional.Frontend.Models
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="app-container">
    <!-- Sidebar -->
    <aside class="sidebar @(sidebarCollapsed ? "collapsed" : "")"
        @onmouseenter="async () => await SetSidebarState(false)"
           @onmouseleave="async () => await SetSidebarState(true)"
           style="transition: all 0.3s ease;">
        <div class="sidebar-header">
            <h3>🩺 Kinesiología</h3>
            <p class="text-muted">Sistema de Gestión</p>
        </div>
        <nav class="sidebar-nav">
            <a href="/dashboard" class="nav-link @(IsActive("/dashboard") ? "active" : "")">
                <span class="nav-icon">📊</span>
                <span class="nav-text">Dashboard</span>
            </a>
            <a href="/pacientes" class="nav-link @(IsActive("/pacientes") ? "active" : "")">
                <span class="nav-icon">👤</span>
                <span class="nav-text">Pacientes</span>
            </a>
            <a href="/sesiones" class="nav-link @(IsActive("/sesiones") ? "active" : "")">
                <span class="nav-icon">📅</span>
                <span class="nav-text">Sesiones</span>
            </a>
            <a href="/calendario" class="nav-link @(IsActive("/calendario") ? "active" : "")">
                <span class="nav-icon">🗓️</span>
                <span class="nav-text">Calendario</span>
            </a>
            <a href="/reportes" class="nav-link @(IsActive("/reportes") ? "active" : "")">
                <span class="nav-icon">📄</span>
                <span class="nav-text">Reportes</span>
            </a>
        </nav>
        <div class="sidebar-footer">
            <button class="btn btn-danger btn-sm w-100" @onclick="Logout">
                <span class="nav-icon">🚪</span>
                <span class="nav-text">Cerrar Sesión</span>
            </button>
        </div>
    </aside>

    <!-- Botón para colapsar sidebar en mobile -->
    <button class="sidebar-toggle" @onclick="ToggleSidebar" style="position: fixed; top: 15px; left: 15px; z-index: 1000; background: white; border: none; border-radius: 8px; padding: 8px 12px; box-shadow: var(--box-shadow); display: none;">
        ☰
    </button>

    <!-- Contenido principal -->
    <main class="main-content">
        <header class="main-header">
            <h1>@PageHeading</h1>
            <div class="user-info">
                <span class="user-avatar">👋</span>
                <span>@UserName</span>
            </div>
        </header>
        <div class="page-content">
            @Body
        </div>
    </main>
</div>

@code {
    private string UserName { get; set; } = "Usuario";
    private bool sidebarCollapsed = true;

    private string PageHeading => Navigation.Uri switch
    {
        var u when u.Contains("/pacientes/crear", StringComparison.OrdinalIgnoreCase) => "Nuevo Paciente",
        var u when u.Contains("/pacientes/editar", StringComparison.OrdinalIgnoreCase) => "Editar Paciente",
        var u when u.Contains("/sesiones/editar", StringComparison.OrdinalIgnoreCase) => "Editar Sesión",
        var u when u.Contains("/sesiones/crear", StringComparison.OrdinalIgnoreCase) => "Nueva Sesión",
        var u when u.Contains("/pacientes", StringComparison.OrdinalIgnoreCase) => "Pacientes",
        var u when u.Contains("/sesiones", StringComparison.OrdinalIgnoreCase) => "Sesiones",
        var u when u.Contains("/calendario", StringComparison.OrdinalIgnoreCase) => "Calendario",
        var u when u.Contains("/reportes", StringComparison.OrdinalIgnoreCase) => "Reportes",
        var u when u.Contains("/login", StringComparison.OrdinalIgnoreCase) => "Iniciar Sesión",
        var u when u.Contains("/register", StringComparison.OrdinalIgnoreCase) => "Crear Cuenta",
        var u when u.Contains("/dashboard", StringComparison.OrdinalIgnoreCase) => "Dashboard",
        _ => "Kinesiología"
    };

    protected override async Task OnInitializedAsync()
    {
        var userJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "user");
        if (!string.IsNullOrEmpty(userJson))
        {
            var user = System.Text.Json.JsonSerializer.Deserialize<AuthResponse>(userJson);
            UserName = user?.Nombre ?? "Usuario";
        }

        // Detectar si es mobile consultando window.innerWidth vía JSInterop
        try
        {
            var width = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            if (width <= 768)
            {
                sidebarCollapsed = true;
            }
        }
        catch
        {
            // Si falla el JS interop, conservar el valor por defecto
        }
    }

    private bool IsActive(string path) => Navigation.Uri.Contains(path, StringComparison.OrdinalIgnoreCase);

    private void ToggleSidebar() => sidebarCollapsed = !sidebarCollapsed;
    
    private async Task SetSidebarState(bool collapsed)
    {
        try
        {
            var width = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            if (width > 768) // Solo para desktop
            {
                sidebarCollapsed = collapsed;
            }
        }
        catch
        {
            // En caso de fallo, aplicar el cambio como fallback
            sidebarCollapsed = collapsed;
        }
    }

    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "token");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "user");
        Navigation.NavigateTo("/login");
    }
}

<style>
    .app-container {
        display: flex;
        min-height: 100vh;
    }

    /* Sidebar */
    .sidebar {
        width: 250px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        height: 100vh;
        position: sticky;
        top: 0;
        overflow-x: hidden;
        overflow-y: auto;
        background: #0f172a;
        color: #e2e8f0;
        transition: all 0.3s ease;
    }

    .sidebar-header {
        padding: 22px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        white-space: nowrap;
        overflow: hidden;
    }

        .sidebar-header h3 {
            margin: 0;
            color: white;
            font-size: 1.1rem;
        }

        .sidebar-header p {
            margin: 4px 0 0 0;
            color: #94a3b8;
            font-size: 0.8rem;
        }

    .sidebar-nav {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 16px 12px;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 8px;
        color: #cbd5e1;
        text-decoration: none;
        white-space: nowrap;
        overflow: hidden;
        transition: var(--transition);
    }

        .nav-link:hover {
            background: rgba(255, 255, 255, 0.08);
            color: white;
        }

        .nav-link.active {
            background: var(--primary-color);
            color: white;
        }

    .nav-icon {
        flex-shrink: 0;
        width: 22px;
        font-size: 1.15rem;
        text-align: center;
    }

    .sidebar-footer {
        padding: 16px 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

        .sidebar.collapsed {
            width: 70px;
        }

            .sidebar.collapsed .nav-link {
                justify-content: center;
                padding: 10px;
            }

            .sidebar.collapsed .nav-text {
                display: none;
            }

            .sidebar.collapsed .sidebar-header h3,
            .sidebar.collapsed .sidebar-header p {
                display: none;
            }

            .sidebar.collapsed .nav-icon {
                margin-right: 0;
                font-size: 1.5rem;
            }

            .sidebar.collapsed .sidebar-footer .nav-text {
                display: none;
            }

    /* Contenido principal */
    .main-content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .main-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 30px;
        background: white;
        box-shadow: var(--box-shadow);
        position: sticky;
        top: 0;
        z-index: 10;
    }

        .main-header h1 {
            margin: 0;
            font-size: 1.4rem;
            color: var(--text-primary);
        }

    .user-info {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 500;
        color: var(--text-secondary);
    }

    .user-avatar {
        font-size: 1.3rem;
    }

    .page-content {
        flex: 1;
        padding: 30px;
    }

    @@media (max-width: 768px) {
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            z-index: 999;
            transform: translateX(-100%);
            width: 250px;
        }

            .sidebar:not(.collapsed) {
                transform: translateX(0);
            }

        .sidebar-toggle {
            display: block !important;
        }

        .main-content {
            padding: 15px;
        }
    }
</style>