@page "/sesiones"
@using Profesional.Frontend.Models
@using Profesional.Frontend.Services
@inject SesionService SesionService
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<PageTitle>Sesiones</PageTitle>

<div class="sesiones-container">
    <div class="sesiones-header">
        <div class="header-left">
            <h2>📅 Sesiones</h2>
            <span class="badge">@(sesionesFiltradas?.Count ?? 0) registros</span>
        </div>
        <div class="header-right">
            <div class="search-box">
                <input type="text" @bind="searchTerm" @bind:event="oninput" @bind:after="OnFiltroCambiado" placeholder="Buscar por paciente o tratamiento..." />
            </div>
            <select class="form-select" @bind="estadoFiltro" @bind:after="OnFiltroCambiado">
                <option value="">Todos los estados</option>
                <option value="pendiente">Pendientes</option>
                <option value="completada">Completadas</option>
            </select>
            <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/pacientes")'>
                ➕ Nueva Sesión
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (isLoading)
    {
        <LoadingSkeleton />
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th @onclick='() => SortBy("Fecha")'>Fecha <span class="sort-arrow">@GetSortArrow("Fecha")</span></th>
                    <th @onclick='() => SortBy("PacienteNombre")'>Paciente <span class="sort-arrow">@GetSortArrow("PacienteNombre")</span></th>
                    <th>Tratamiento</th>
                    <th>Duración</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (sesionesPagina != null && sesionesPagina.Any())
                {
                    foreach (var s in sesionesPagina)
                    {
                        <tr>
                            <td>@s.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@s.PacienteNombre</td>
                            <td>@s.TipoTratamiento</td>
                            <td>@s.DuracionMinutos min</td>
                            <td>
                                <span class="badge @(s.Completada ? "bg-success" : "bg-warning")">
                                    @(s.Completada ? "Completada" : "Pendiente")
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => Editar(s.Id)">Editar</button>
                                @if (!s.Completada)
                                {
                                    <button class="btn btn-success btn-sm" @onclick="() => Completar(s.Id)">Completar</button>
                                }
                                <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(s)">Eliminar</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No hay sesiones registradas</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (totalPaginas > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage > 1 ? "" : "disabled")">
                        <a class="page-link" href="#" @onclick:preventDefault @onclick="() => GoToPage(currentPage - 1)">Anterior</a>
                    </li>
                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        var pageNum = i;
                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault @onclick="() => GoToPage(pageNum)">@pageNum</a>
                        </li>
                    }
                    <li class="page-item @(currentPage < totalPaginas ? "" : "disabled")">
                        <a class="page-link" href="#" @onclick:preventDefault @onclick="() => GoToPage(currentPage + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@code {
    private List<SesionDto>? sesiones;
    private List<SesionDto>? sesionesFiltradas;
    private List<SesionDto>? sesionesPagina;
    private bool isLoading = true;
    private string? errorMessage;

    private string searchTerm = string.Empty;
    private string estadoFiltro = string.Empty;
    private string? sortBy = "Fecha";
    private bool sortDescending = true;

    private int currentPage = 1;
    private const int pageSize = 10;
    private int totalPaginas = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadSesiones();
    }

    private async Task LoadSesiones()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            sesiones = await SesionService.GetAllSesionesAsync();
            if (sesiones == null)
            {
                errorMessage = "No se pudo cargar la lista de sesiones.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar la lista de sesiones: {ex.Message}";
            sesiones = null;
        }
        finally
        {
            isLoading = false;
        }
        AplicarFiltros();
    }

    private void OnFiltroCambiado()
    {
        currentPage = 1;
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        IEnumerable<SesionDto> query = sesiones ?? Enumerable.Empty<SesionDto>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(s =>
                (s.PacienteNombre?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (s.TipoTratamiento?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (estadoFiltro == "pendiente")
        {
            query = query.Where(s => !s.Completada);
        }
        else if (estadoFiltro == "completada")
        {
            query = query.Where(s => s.Completada);
        }

        query = sortBy switch
        {
            "PacienteNombre" => sortDescending ? query.OrderByDescending(s => s.PacienteNombre) : query.OrderBy(s => s.PacienteNombre),
            _ => sortDescending ? query.OrderByDescending(s => s.Fecha) : query.OrderBy(s => s.Fecha)
        };

        sesionesFiltradas = query.ToList();
        totalPaginas = Math.Max(1, (int)Math.Ceiling(sesionesFiltradas.Count / (double)pageSize));
        currentPage = Math.Min(currentPage, totalPaginas);
        ActualizarPagina();
    }

    private void ActualizarPagina()
    {
        sesionesPagina = sesionesFiltradas?
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPaginas) return;
        currentPage = page;
        ActualizarPagina();
    }

    private void SortBy(string field)
    {
        if (sortBy == field)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortBy = field;
            sortDescending = false;
        }
        currentPage = 1;
        AplicarFiltros();
    }

    private string GetSortArrow(string field)
    {
        if (sortBy != field) return "↕";
        return sortDescending ? "↓" : "↑";
    }

    private void Editar(int id) => Navigation.NavigateTo($"/sesiones/editar/{id}");

    private async Task Completar(int id)
    {
        var ok = await SesionService.CompletarSesionAsync(id);
        if (ok)
        {
            await NotificationService.ShowSuccessAsync("Sesión marcada como completada");
            await LoadSesiones();
        }
        else
        {
            await NotificationService.ShowErrorAsync("Error al completar la sesión");
        }
    }

    private async Task Eliminar(SesionDto sesion)
    {
        if (await NotificationService.ShowConfirmAsync("Confirmar eliminación", $"¿Estás seguro de eliminar la sesión de {sesion.PacienteNombre} del {sesion.Fecha:dd/MM/yyyy}?"))
        {
            var ok = await SesionService.DeleteSesionAsync(sesion.Id);
            if (ok)
            {
                await NotificationService.ShowSuccessAsync("Sesión eliminada correctamente");
                await LoadSesiones();
            }
            else
            {
                await NotificationService.ShowErrorAsync("Error al eliminar la sesión");
            }
        }
    }
}

<style>
    .sesiones-container {
        padding: 0;
    }

    .sesiones-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 20px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-right {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
    }

    .search-box input {
        padding: 8px 12px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        width: 240px;
    }

    .form-select {
        padding: 8px 12px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
    }

    @@media (max-width: 768px) {
        .sesiones-header {
            flex-direction: column;
            align-items: stretch;
        }

        .header-right {
            flex-direction: column;
        }

        .search-box input, .form-select {
            width: 100%;
        }

        .table {
            font-size: 0.85rem;
        }

            .table th, .table td {
                padding: 8px 10px;
            }

        .btn-sm {
            padding: 4px 8px;
            font-size: 0.75rem;
        }
    }
</style>
