@page "/sesiones/editar/{id:int}"
@using Profesional.Frontend.Models
@using Profesional.Frontend.Services
@inject SesionService SesionService
@inject NavigationManager Navigation

<PageTitle>Editar Sesión</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p>Cargando datos de la sesión...</p>
    </div>
}
else if (sesionDto == null)
{
    <div class="alert alert-danger">Sesión no encontrada</div>
}
else
{
    <div class="page-header">
        <h2>✏️ Editar Sesión</h2>
        <p>Modificá los datos de la sesión del paciente @sesionDto.PacienteNombre</p>
    </div>

    <div class="form-container">
        <SesionForm Sesion="@sesion"
                    OnValidSubmit="@HandleValidSubmit"
                    OnCancel="@Cancel"
                    IsLoading="@isSaving"
                    ErrorMessage="@errorMessage" />
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private SesionCreateDto sesion = new();
    private SesionDto? sesionDto;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadSesion();
    }

    private async Task LoadSesion()
    {
        isLoading = true;
        sesionDto = await SesionService.GetSesionByIdAsync(Id);
        if (sesionDto != null)
        {
            sesion = new SesionCreateDto
            {
                PacienteId = sesionDto.PacienteId,
                Fecha = sesionDto.Fecha,
                TipoTratamiento = sesionDto.TipoTratamiento,
                Observaciones = sesionDto.Observaciones,
                Evolucion = sesionDto.Evolucion,
                ProximaCita = sesionDto.ProximaCita,
                DuracionMinutos = sesionDto.DuracionMinutos,
                Completada = sesionDto.Completada
            };
        }
        isLoading = false;
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            var result = await SesionService.UpdateSesionAsync(Id, sesion);
            if (result != null)
            {
                Navigation.NavigateTo($"/pacientes/{sesion.PacienteId}");
            }
            else
            {
                errorMessage = "Error al actualizar la sesión. Verificá los datos.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/pacientes/{sesion.PacienteId}");
    }
}