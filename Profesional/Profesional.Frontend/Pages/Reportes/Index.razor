@page "/reportes"
@using Profesional.Frontend.Models
@using Profesional.Frontend.Services
@inject DashboardService DashboardService
@inject NavigationManager Navigation

<PageTitle>Reportes</PageTitle>

<div class="reportes-container">
    <div class="reportes-header">
        <h2>📄 Reportes</h2>
        <p>Resumen de la actividad y descarga de reportes</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-warning">@errorMessage</div>
    }

    @if (isLoading)
    {
        <LoadingSkeleton />
    }
    else
    {
        <div class="metricas-grid">
            <div class="metric-card" style="border-left:4px solid #4fc3f7;">
                <div class="metric-icon">👤</div>
                <div class="metric-info">
                    <span class="metric-value">@(dashboardData?.TotalPacientesActivos ?? 0)</span>
                    <span class="metric-label">Pacientes Activos</span>
                </div>
            </div>

            <div class="metric-card" style="border-left:4px solid #81c784;">
                <div class="metric-icon">📅</div>
                <div class="metric-info">
                    <span class="metric-value">@(dashboardData?.TotalSesionesMes ?? 0)</span>
                    <span class="metric-label">Sesiones este mes</span>
                </div>
            </div>

            <div class="metric-card" style="border-left:4px solid #ffb74d;">
                <div class="metric-icon">⏰</div>
                <div class="metric-info">
                    <span class="metric-value">@(dashboardData?.ProximasCitas ?? 0)</span>
                    <span class="metric-label">Próximas citas (7 días)</span>
                </div>
            </div>
        </div>

        <div class="card-modern reportes-card">
            <h4>📥 Reportes disponibles</h4>
            <div class="reporte-item">
                <div class="reporte-info">
                    <span class="reporte-titulo">Listado de Pacientes</span>
                    <span class="reporte-descripcion">Exporta el listado completo de pacientes a un archivo Excel (.xlsx)</span>
                </div>
                <button class="btn btn-secondary" @onclick="ExportarPacientesExcel">
                    📥 Exportar Excel
                </button>
            </div>
        </div>
    }
</div>

@code {
    private DashboardResponseDto? dashboardData;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            dashboardData = await DashboardService.GetDashboardDataAsync();
            if (dashboardData == null)
            {
                errorMessage = "No se pudo cargar el resumen de actividad.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el resumen de actividad: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ExportarPacientesExcel()
    {
        Navigation.NavigateTo("/api/reportes/pacientes", true);
    }
}

<style>
    .reportes-container {
        padding: 0;
    }

    .reportes-header {
        margin-bottom: 25px;
    }

        .reportes-header h2 {
            margin: 0;
            color: #1a1a2e;
        }

        .reportes-header p {
            margin: 5px 0 0 0;
            color: #616161;
        }

    .metricas-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .metric-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .metric-icon {
        font-size: 2rem;
    }

    .metric-info {
        display: flex;
        flex-direction: column;
    }

    .metric-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a2e;
    }

    .metric-label {
        color: #616161;
        font-size: 0.85rem;
    }

    .reportes-card h4 {
        margin: 0 0 15px 0;
    }

    .reporte-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        padding: 15px;
        border: 1px solid #e9ecef;
        border-radius: 10px;
    }

    .reporte-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .reporte-titulo {
        font-weight: 600;
        color: #1a1a2e;
    }

    .reporte-descripcion {
        color: #616161;
        font-size: 0.85rem;
    }

    @@media (max-width: 768px) {
        .reporte-item {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>
