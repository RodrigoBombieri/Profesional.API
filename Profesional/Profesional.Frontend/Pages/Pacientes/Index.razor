@page "/pacientes"
@using Profesional.Frontend.Models
@using Profesional.Frontend.Services
@inject PacienteService PacienteService
@inject IJSRuntime JSRuntime

<PageTitle>Pacientes</PageTitle>

<div class="pacientes-container">
    <!-- Header y búsqueda -->
    <div class="pacientes-header">
        <div class="header-left">
            <h2>👤 Pacientes</h2>
            <span class="badge">@(pagedResponse?.TotalRecords ?? 0) registros</span>
        </div>
        <div class="header-right">
            <div class="search-box">
                <input type="text" @bind="searchTerm" placeholder="Buscar..." />
                <button class="btn btn-primary btn-sm" @onclick="Search">🔍 Buscar</button>
            </div>
            <button class="btn btn-success" @onclick="GoToCreate">➕ Nuevo Paciente</button>
            <button class="btn btn-secondary" @onclick="ExportarReporte">
                📥 Exportar Excel
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <!-- Tabla de pacientes -->
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th @onclick='() => SortBy("Id")'>ID <span class="sort-arrow">@GetSortArrow("Id")</span></th>
                <th @onclick='() => SortBy("Nombre")'>Nombre <span class="sort-arrow">@GetSortArrow("Nombre")</span></th>
                <th @onclick='() => SortBy("Apellido")'>Apellido <span class="sort-arrow">@GetSortArrow("Apellido")</span></th>
                <th>DNI</th>
                <th>Email</th>
                <th>Teléfono</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (pagedResponse?.Data != null && pagedResponse.Data.Any())
            {
                foreach (var p in pagedResponse.Data)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Nombre</td>
                        <td>@p.Apellido</td>
                        <td>@p.DNI</td>
                        <td>@p.Email</td>
                        <td>@p.Telefono</td>
                        <td>
                            <button class="btn btn-info btn-sm" @onclick="() => VerDetalle(p.Id)">Ver</button>
                            <button class="btn btn-warning btn-sm" @onclick="() => Editar(p.Id)">Editar</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No hay pacientes registrados</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Paginación -->
    @if (pagedResponse != null && pagedResponse.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(pagedResponse.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" href="#" @onclick="() => GoToPage(pagedResponse.PageNumber - 1)">Anterior</a>
                </li>
                @for (int i = 1; i <= pagedResponse.TotalPages; i++)
                {
                    <li class="page-item @(pagedResponse.PageNumber == i ? "active" : "")">
                        <a class="page-link" href="#" @onclick="() => GoToPage(i)">@i</a>
                    </li>
                }
                <li class="page-item @(pagedResponse.HasNextPage ? "" : "disabled")">
                    <a class="page-link" href="#" @onclick="() => GoToPage(pagedResponse.PageNumber + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>

@code {
    private PagedResponse<PacienteDto>? pagedResponse;
    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private string? sortBy;
    private bool sortDescending = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPacientes();
    }

    private async Task LoadPacientes()
    {
        errorMessage = null;
        try
        {
            pagedResponse = await PacienteService.GetPacientesAsync(
                currentPage,
                pageSize,
                searchTerm,
                true,
                sortBy,
                sortDescending
            );
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar la lista de pacientes: {ex.Message}";
            pagedResponse = null;
        }
    }

    private async Task Search()
    {
        currentPage = 1;
        await LoadPacientes();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > pagedResponse?.TotalPages) return;
        currentPage = page;
        await LoadPacientes();
    }

    private async Task SortBy(string field)
    {
        if (sortBy == field)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortBy = field;
            sortDescending = false;
        }
        currentPage = 1;
        await LoadPacientes();
    }

    private string GetSortArrow(string field)
    {
        if (sortBy != field) return "↕";
        return sortDescending ? "↓" : "↑";
    }

    private void GoToCreate() => NavigationManager.NavigateTo("/pacientes/crear");
    private void VerDetalle(int id) => NavigationManager.NavigateTo($"/pacientes/{id}");
    private void Editar(int id) => NavigationManager.NavigateTo($"/pacientes/editar/{id}");

    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    private void ExportarReporte()
    {
        NavigationManager.NavigateTo("/api/reportes/pacientes", true);
    }
}

<style>
    .pacientes-container {
        padding: 0;
    }

    .pacientes-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 20px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-right {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
    }

    .search-box {
        display: flex;
        gap: 8px;
    }

        .search-box input {
            padding: 8px 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            width: 200px;
        }

    @@media (max-width: 768px) {
        .pacientes-header {
            flex-direction: column;
            align-items: stretch;
        }

        .header-right {
            flex-direction: column;
        }

        .search-box {
            width: 100%;
        }

            .search-box input {
                width: 100%;
            }

        .table {
            font-size: 0.85rem;
        }

            .table th, .table td {
                padding: 8px 10px;
            }

        .btn-sm {
            padding: 4px 8px;
            font-size: 0.75rem;
        }
    }
</style>
