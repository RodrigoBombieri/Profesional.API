@page "/pacientes/{id:int}"
@using Profesional.Frontend.Models
@using Profesional.Frontend.Services
@inject PacienteService PacienteService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService

<PageTitle>Detalle del Paciente</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p>Cargando datos del paciente...</p>
    </div>
}
else if (paciente == null)
{
    <div class="alert alert-danger">Paciente no encontrado</div>
}
else
{
    <div class="page-header">
        <h2>👤 @paciente.Nombre @paciente.Apellido</h2>
        <div class="header-actions">
            <button class="btn btn-warning" @onclick='() => Navigation.NavigateTo($"/pacientes/editar/{paciente.Id}")'>
                ✏️ Editar
            </button>
            <button class="btn btn-danger" @onclick="EliminarPaciente">
                🗑️ Eliminar
            </button>
            <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/pacientes")'>
                ← Volver
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="detalle-grid">
        <!-- Información personal -->
        <div class="card info-card">
            <div class="card-header">
                <h4>📋 Información Personal</h4>
            </div>
            <div class="card-body">
                <div class="info-row">
                    <span class="label">DNI:</span>
                    <span class="value">@paciente.DNI</span>
                </div>
                <div class="info-row">
                    <span class="label">Teléfono:</span>
                    <span class="value">@paciente.Telefono</span>
                </div>
                <div class="info-row">
                    <span class="label">Email:</span>
                    <span class="value">@paciente.Email</span>
                </div>
                <div class="info-row">
                    <span class="label">Dirección:</span>
                    <span class="value">@paciente.Direccion</span>
                </div>
                <div class="info-row">
                    <span class="label">Obra Social:</span>
                    <span class="value">@paciente.ObraSocial</span>
                </div>
                <div class="info-row">
                    <span class="label">Fecha Registro:</span>
                    <span class="value">@paciente.FechaRegistro.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="info-row">
                    <span class="label">Estado:</span>
                    <span class="badge @(paciente.Activo ? "bg-success" : "bg-danger")">
                        @(paciente.Activo ? "Activo" : "Inactivo")
                    </span>
                </div>
            </div>
        </div>

        <!-- Sesiones del paciente -->
        <div class="card sesiones-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4>📅 Historial de Sesiones</h4>
                <button class="btn btn-primary btn-sm" @onclick='() => Navigation.NavigateTo($"/pacientes/{paciente.Id}/sesiones/crear")'>
                    ➕ Nueva Sesión
                </button>
            </div>
            <div class="card-body">
                @if (paciente.Sesiones != null && paciente.Sesiones.Any())
                {
                    <table class="table table-striped table-sm">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tratamiento</th>
                                <th>Duración</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sesion in paciente.Sesiones.OrderByDescending(s => s.Fecha))
                            {
                                <tr>
                                    <td>@sesion.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@sesion.TipoTratamiento</td>
                                    <td>@sesion.DuracionMinutos min</td>
                                    <td>
                                        <span class="badge @(sesion.Completada ? "bg-success" : "bg-warning")">
                                            @(sesion.Completada ? "Completada" : "Pendiente")
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-info btn-sm" @onclick="() => VerSesion(sesion.Id)">Ver</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted text-center">Este paciente no tiene sesiones registradas</p>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private PacienteDetalleDto? paciente;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPaciente();
    }

    private async Task LoadPaciente()
    {
        isLoading = true;
        paciente = await PacienteService.GetPacienteDetalleAsync(Id);
        isLoading = false;
    }

    private async Task EliminarPaciente()
    {
        if (await NotificationService.ShowConfirmAsync("Confirmar eliminación", $"¿Estás seguro de eliminar a {paciente?.Nombre} {paciente?.Apellido}?"))
        {
            var result = await PacienteService.DeletePacienteAsync(Id);
            if (result)
            {
                await NotificationService.ShowSuccessAsync("Paciente eliminado correctamente");
                Navigation.NavigateTo("/pacientes");
            }
            else
            {
                await NotificationService.ShowErrorAsync("Error al eliminar el paciente");
            }
        }
    }

    private void VerSesion(int sesionId)
    {
        Navigation.NavigateTo($"/sesiones/{sesionId}");
    }
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }
    .header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    .detalle-grid {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 25px;
    }
    .info-card, .sesiones-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        overflow: hidden;
    }
    .card-header {
        padding: 15px 20px;
        background: #f8f9fa;
        border-bottom: 1px solid #e9ecef;
    }
    .card-header h4 {
        margin: 0;
        font-size: 1.1rem;
    }
    .card-body {
        padding: 20px;
    }
    .info-row {
        display: flex;
        padding: 8px 0;
        border-bottom: 1px solid #f1f3f5;
    }
    .info-row:last-child {
        border-bottom: none;
    }
    .label {
        font-weight: 600;
        width: 120px;
        color: #616161;
    }
    .value {
        flex: 1;
        color: #1a1a2e;
    }
</style>