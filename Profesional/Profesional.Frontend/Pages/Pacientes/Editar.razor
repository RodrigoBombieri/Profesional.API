@page "/pacientes/editar/{id:int}"
@using Profesional.Frontend.Models
@using Profesional.Frontend.Services
@inject PacienteService PacienteService
@inject NavigationManager Navigation

<PageTitle>Editar Paciente</PageTitle>

@if (isLoading)
{
    <LoadingSkeleton />
}
else if (pacienteDto == null)
{
    <div class="alert alert-danger">Paciente no encontrado</div>
}
else
{
    <div class="page-header">
        <h2>✏️ Editar Paciente</h2>
        <p>Modificá los datos de @pacienteDto.Nombre @pacienteDto.Apellido</p>
    </div>

    <div class="form-container">
        <PacienteForm 
            Paciente="@paciente" 
            OnValidSubmit="@HandleValidSubmit" 
            OnCancel="@Cancel"
            IsLoading="@isSaving"
            ErrorMessage="@errorMessage" />
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private PacienteCreateDto paciente = new();
    private PacienteDto? pacienteDto;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPaciente();
    }

    private async Task LoadPaciente()
    {
        isLoading = true;
        pacienteDto = await PacienteService.GetPacienteByIdAsync(Id);
        if (pacienteDto != null)
        {
            paciente = new PacienteCreateDto
            {
                Nombre = pacienteDto.Nombre,
                Apellido = pacienteDto.Apellido,
                DNI = pacienteDto.DNI,
                Telefono = pacienteDto.Telefono,
                Email = pacienteDto.Email,
                Direccion = pacienteDto.Direccion,
                ObraSocial = pacienteDto.ObraSocial
            };
        }
        isLoading = false;
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            var result = await PacienteService.UpdatePacienteAsync(Id, paciente);
            if (result != null)
            {
                Navigation.NavigateTo("/pacientes");
            }
            else
            {
                errorMessage = "Error al actualizar el paciente. Verificá los datos.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/pacientes");
    }
}